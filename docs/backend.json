{
    "entities": {
        "Customer": {
            "title": "Customer",
            "description": "Represents a customer who has made a purchase.",
            "type": "object",
            "properties": {
                "name": {
                    "type": "string",
                    "description": "The customer's full name."
                },
                "email": {
                    "type": "string",
                    "format": "email",
                    "description": "The customer's email address."
                },
                "createdAt": {
                    "type": "string",
                    "format": "date-time",
                    "description": "The timestamp when the customer was created."
                }
            },
            "required": [
                "name",
                "email",
                "createdAt"
            ]
        }
    },
    "auth": {
        "providers": []
    },
    "firestore": {
        "/customers/{customerId}": {
            "schema": {
                "$ref": "#/entities/Customer"
            },
            "description": "Stores information about customers who have made a purchase."
        }
    }
}
